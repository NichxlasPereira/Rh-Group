generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Material {
  id           String   @id @default(cuid())
  name         String
  category     String
  unit         String
  quantity     Float
  minQuantity  Float    @default(5)
  location     String?
  supplier     String?
  price        Float?
  purchaseLink String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  withdrawals Withdrawal[]

  @@index([category])
}

model Withdrawal {
  id           String    @id @default(cuid())
  materialId   String?
  material     Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  materialName String
  category     String
  unit         String
  quantity     Float
  date         DateTime
  withdrawnBy  String
  timestamp    DateTime  @default(now())

  @@index([materialId])
  @@index([timestamp])
}

model Employee {
  id         String   @id @default(cuid())
  name       String
  department String?
  role       String?
  active     Boolean  @default(true)
  // Total de dias de folga a que o colaborador tem direito. O saldo restante
  // é este total menos os dias já lançados como ocorrência do tipo "folga".
  folgaAllowance Int  @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  occurrences AttendanceOccurrence[]

  @@index([name])
}

// Ocorrência de frequência: atraso, falta ou atestado. Guarda uma cópia do
// nome/setor do colaborador (como Withdrawal faz com o material) para o
// histórico continuar legível mesmo após a exclusão do cadastro.
model AttendanceOccurrence {
  id                 String    @id @default(cuid())
  employeeId         String?
  employee           Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeName       String
  employeeDepartment String?
  type               String // "atraso" | "falta" | "atestado" | "folga"
  date               DateTime
  // Atestado e folga: último dia coberto (inclusivo). Nos demais tipos é igual a `date`.
  endDate            DateTime
  // Atraso: minutos de atraso.
  minutesLate        Int?
  // Falta: se foi justificada. Atestado é sempre justificado; atraso, conforme informado.
  justified          Boolean   @default(false)
  // Folga: gestor que concedeu.
  approvedBy         String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  attachments AttendanceAttachment[]

  @@index([employeeId])
  @@index([date])
  @@index([type])
}

// Documento anexado a uma ocorrência (ex.: foto ou PDF do atestado). O arquivo
// fica em disco, ao lado do banco (ver src/lib/attachmentStorage.ts).
model AttendanceAttachment {
  id           String               @id @default(cuid())
  occurrenceId String
  occurrence   AttendanceOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  storedName   String               @unique
  createdAt    DateTime             @default(now())

  @@index([occurrenceId])
}

// Pessoas autorizadas a acessar o módulo de frequência (RH). Cada uma entra
// com o próprio e-mail e senha; administradores gerenciam os acessos.
model FrequenciaUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("member") // "admin" | "member"
  active       Boolean   @default(true)
  // Cadastro feito pela própria pessoa: só entra depois que um administrador aprovar.
  pending      Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions FrequenciaSession[]
}

// Sessão aberta. O navegador guarda um token aleatório; aqui fica só o hash
// dele, então um vazamento do banco não permite reutilizar sessões.
model FrequenciaSession {
  id        String         @id // sha256 do token do cookie
  userId    String
  user      FrequenciaUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime       @default(now())

  @@index([userId])
}

// Admissão digital: o RH cria, o candidato envia os documentos por um link
// privado (sem login) e o RH aprova ou recusa cada um.
model Admission {
  id            String    @id @default(cuid())
  // Preenchido pelo próprio candidato no link (campo "nome").
  candidateName String?
  email         String?
  phone         String?
  role          String?
  department    String?
  startDate     DateTime?
  status        String    @default("em_andamento") // "em_andamento" | "concluida" | "cancelada"
  notes         String?
  // Link do candidato: o banco guarda só o hash do token.
  tokenHash      String   @unique
  tokenExpiresAt DateTime
  createdBy      String?
  // Colaborador criado ao concluir a admissão.
  employeeId String?
  // Cópia dos documentos no Google Drive, feita ao concluir.
  driveStatus    String? // "enviado" | "erro" | "nao_configurado"
  driveFolderId  String?
  driveFolderUrl String?
  driveError     String?
  driveSyncedAt  DateTime?
  // Quando o candidato enviou os dados pela primeira vez (botão "Enviar dados").
  submittedAt DateTime?
  // Quando foi cancelado: depois de 90 dias o onboarding e os arquivos são apagados (LGPD).
  closedAt DateTime?
  // Empresa que contrata — usada no acordo de confidencialidade (NDA).
  contractingCompanyId String?
  contractingCompany   ContractingCompany? @relation(fields: [contractingCompanyId], references: [id], onDelete: SetNull)
  // Linha na planilha do Google Sheets (criada quando o candidato envia tudo).
  sheetStatus   String? // "ok" | "erro" | "nao_configurado"
  sheetError    String?
  sheetSyncedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  documents AdmissionDocument[]
  fields    AdmissionField[]
}

// Dado pedido ao candidato (nome, CPF, chave Pix...). O RH escolhe quais; o
// candidato preenche no link.
model AdmissionField {
  id          String    @id @default(cuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  key         String // "nome", "cpf"... ou "extra-<n>" para campos criados pelo RH
  label       String
  type        String    @default("text") // text | cpf | date | email | tel | textarea
  required    Boolean   @default(true)
  sortOrder   Int       @default(0)
  value       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([admissionId, key])
  @@index([admissionId])
}

model AdmissionDocument {
  id          String    @id @default(cuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  // "upload" (documento comum) ou um termo gerado pelo sistema e assinado no gov.br:
  // "nda" (acordo de confidencialidade) ou "imagem" (termo de uso de imagem).
  kind        String    @default("upload")
  name        String
  description String?
  required    Boolean   @default(true)
  sortOrder   Int       @default(0)
  status      String    @default("pendente") // "pendente" | "enviado" | "aprovado" | "recusado"
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  // Termos gerados: o representante da empresa assina (gov.br) depois do candidato.
  companySignedAt DateTime?
  companySignedBy String? // quem do RH enviou a versão assinada pela empresa
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  files AdmissionFile[]

  @@index([admissionId])
}

model AdmissionFile {
  id         String            @id @default(cuid())
  documentId String
  document   AdmissionDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  size       Int
  storedName String            @unique
  // Quem enviou: o candidato (no link) ou o RH, com a versão assinada pela empresa.
  origin     String            @default("candidato") // "candidato" | "empresa"
  // Arquivo já copiado para o Google Drive (evita duplicar ao tentar de novo).
  driveFileId String?
  createdAt  DateTime          @default(now())

  @@index([documentId])
}

// Configurações simples do sistema (chave → valor). Hoje: o hash do token do
// link de exportação usado pela planilha do RH (=IMPORTDATA).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Empresa contratante do acordo de confidencialidade. Fica só no banco (o
// repositório é público e a qualificação traz CPFs dos sócios).
model ContractingCompany {
  id            String   @id @default(cuid())
  name          String
  qualification String // parágrafo de qualificação, como aparece no acordo
  signerName    String // quem assina pela empresa
  signerRole    String // ex.: Sócio administrador
  signerCpf     String
  // Dados separados para os termos que citam CNPJ e sede (ex.: uso de imagem).
  cnpj          String?
  legalNature   String? // ex.: sociedade empresária limitada
  address       String? // logradouro, número e complemento
  district      String?
  city          String?
  state         String?
  cep           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  admissions Admission[]
}
